# Base URL for the API. Leave empty to use same-origin requests, which is what
# both `npm run dev` (Vite proxies to FastAPI) and the Docker/nginx setup expect.
# Set this only when the API lives somewhere else, e.g.:
# VITE_API_BASE=http://localhost:8000
VITE_API_BASE=

# Dev-only: where Vite should proxy API calls during `npm run dev`.
VITE_API_TARGET=http://localhost:8000
