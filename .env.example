# =============================================================================
# Copy to `` and fill in real values. Never commit the real ``.
# =============================================================================

# ---- App ----
APP_NAME=agentic-rag
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# JSON array when overriding, e.g. ["https://app.example.com"]
CORS_ORIGINS=["*"]

# ---- Google Gemini ----
# Put your Gemini API key here (from https://aistudio.google.com/app/apikey).
GOOGLE_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004
# text-embedding-004 -> 768 dims. If you change the embedding model, change
# this to match, and re-create the documents table (the vector column is fixed).
EMBEDDING_DIM=768
LLM_TEMPERATURE=0.0

# ---- PostgreSQL / pgvector ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ragdb
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# Optional: full DSN override (takes precedence over the parts above).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb

# ---- Retrieval / chunking ----
RETRIEVAL_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Langfuse (observability) ----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Frontend ----
# Host port the UI is published on by docker compose (container listens on 80).
WEB_PORT=3000
# Dev only: where `npm run dev` proxies API calls. Leave VITE_API_BASE empty so
# the browser calls the same origin (the Vite proxy / nginx handles the rest).
VITE_API_TARGET=http://localhost:8000
VITE_API_BASE=

# ---- Optional tool providers ----
# Used only if you replace the web-search stub with the real Tavily client.
TAVILY_API_KEY=
